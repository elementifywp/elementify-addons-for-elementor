{
	"name": "elementify-addons-for-elementor",
	"version": "1.0.1",
	"description": "Elementify Addons is a next-gen Elementor plugin that empowers anyone to build stunning, professional websites—faster, easier, and with zero coding.",
	"author": "ElementifyWP",
	"license": "GPL-3.0-or-later",
	"main": "Gruntfile.js",
	"keywords": [
		"wordpress",
		"plugin"
	],
	"private": true,
	"scripts": {
		"composer-start": "shx rm -rf vendor/ composer.lock && composer clear-cache && composer install",
		"composer-build": "shx rm -rf vendor/ composer.lock && composer clear-cache && composer install --no-dev --prefer-dist --optimize-autoloader",
		"build": "npm run clean && wp-scripts build --mode=production",
		"start": "npm run clean && wp-scripts start --mode=development",
		"clean": "shx rm -rf assets/build/*",
		"lint:php": "vendor/bin/phpcs",
		"lint:php:fix": "vendor/bin/phpcbf",
		"lint:js": "wp-scripts lint-js assets/src/js",
		"lint:js:fix": "wp-scripts lint-js assets/src/js --fix",
		"lint:css": "wp-scripts lint-style \"assets/src/sass/**/*.scss\" \"assets/src/css/**/*.css\"",
		"lint:css:fix": "wp-scripts lint-style \"assets/src/sass/**/*.scss\" \"assets/src/css/**/*.css\" --fix",
		"lint:pkg": "wp-scripts lint-pkg-json",
		"format:js": "wp-scripts format assets/src/js",
		"packages-update": "wp-scripts packages-update",
		"cypress:open": "node_modules/.bin/cypress open",
		"translate": "wp i18n make-pot ./ languages/elementify-addons-for-elementor.pot --exclude=builds/,node_modules/,cypress/,vendor --ignore-domain --allow-root",
		"release": "npm run build && npm run translate && grunt build"
	},
	"devDependencies": {
		"@svgr/cli": "^8.1.0",
		"@wordpress/stylelint-config": "^23.28.0",
		"autoprefixer": "^10.4.21",
		"copy-webpack-plugin": "^13.0.1",
		"cross-env": "^7.0.3",
		"css-loader": "^7.1.2",
		"cypress": "^13.6.0",
		"grunt": "^1.5.3",
		"grunt-checktextdomain": "^1.0.1",
		"grunt-contrib-clean": "^2.0.1",
		"grunt-contrib-compress": "^2.0.0",
		"grunt-contrib-copy": "^1.0.0",
		"load-grunt-tasks": "^5.1.0",
		"mini-css-extract-plugin": "^2.9.4",
		"postcss": "^8.5.6",
		"postcss-cli": "^11.0.0",
		"postcss-scss": "^4.0.9",
		"rtlcss-webpack-plugin": "^4.0.7",
		"sass": "^1.93.2",
		"sass-loader": "^16.0.5",
		"shx": "^0.4.0",
		"terser-webpack-plugin": "^5.3.14",
		"webpack": "^5.89.0",
		"webpack-remove-empty-scripts": "^1.1.1"
	},
	"dependencies": {
		"@tailwindcss/postcss": "^4.1.16",
		"@wordpress/base-styles": "^6.12.0",
		"@wordpress/block-editor": "^15.9.0",
		"@wordpress/blocks": "^15.9.0",
		"@wordpress/components": "^30.9.0",
		"@wordpress/compose": "^7.36.0",
		"@wordpress/data": "^10.36.0",
		"@wordpress/element": "^6.36.0",
		"@wordpress/eslint-plugin": "^22.22.0",
		"@wordpress/hooks": "^4.36.0",
		"@wordpress/i18n": "^6.9.0",
		"@wordpress/icons": "^11.3.0",
		"@wordpress/scripts": "^31.1.0",
		"@wordpress/server-side-render": "^6.12.0",
		"atrc": "^1.0.37",
		"classnames": "^2.5.1",
		"css-minimizer-webpack-plugin": "^7.0.2",
		"lodash": "^4.17.21",
		"react-icons": "^5.5.0",
		"tailwindcss": "^4.1.16"
	},
	"browserslist": {
		"production": [
			"> 0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	}
}
